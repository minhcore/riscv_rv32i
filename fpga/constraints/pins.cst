// ==============================================================================
// PHYSICAL CONSTRAINTS FOR Sipeed Tang Nano 9K (GW1NR-LV9QN88PC6/I5)
// ==============================================================================

// Onboard 27 MHz Crystal Oscillator
IO_LOC "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Onboard User Pushbutton S1 (Active-Low Reset)
IO_LOC "btn_reset_n" 3;
IO_PORT "btn_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard User Pushbutton S2 (Active-Low User Button)
IO_LOC "btn_user" 4;
IO_PORT "btn_user" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard User LEDs (Active-Low: 0 = ON, 1 = OFF)
IO_LOC "leds[0]" 10;
IO_LOC "leds[1]" 11;
IO_LOC "leds[2]" 13;
IO_LOC "leds[3]" 14;
IO_LOC "leds[4]" 15;
IO_LOC "leds[5]" 16;
IO_PORT "leds[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[5]" IO_TYPE=LVCMOS33 DRIVE=8;
